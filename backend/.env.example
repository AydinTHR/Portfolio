# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
DB_NAME=portfolio

# ---- Admin auth (single admin) ----
ADMIN_EMAIL=you@example.com
# Generate the hash with:  python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# At least 32 random characters. The server refuses to start in production with
# this placeholder or a shorter secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# ---- Environment / cookies ----
# "production" marks the auth cookie Secure (HTTPS-only)
ENVIRONMENT=development
# Optional: restrict the auth cookie to a domain (leave blank for host-only)
COOKIE_DOMAIN=
# Cookie SameSite policy: lax | strict | none. Use "none" only when the frontend
# and API are on different sites in production (requires HTTPS / Secure cookies).
COOKIE_SAMESITE=lax

# ---- CORS (comma-separated origins allowed to call the API) ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Client IP behind a proxy ----
# Header the proxy sets to the visitor's IP, used for rate limits and analytics.
# On Render use CF-Connecting-IP. Leave blank when nothing sits in front of the API.
# Name only a header your proxy overwrites: visitors can send any header.
CLIENT_IP_HEADER=

# ---- Resend email (contact form) ----
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@example.com

# ---- Analytics ----
ANALYTICS_SALT=change-me-to-a-random-string
